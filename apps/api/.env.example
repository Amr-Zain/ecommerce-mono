# App
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003

# Cache
CACHE_ENABLED=true
REDIS_URL=redis://localhost:6379
CACHE_KEY_PREFIX=ecommerce:api
CACHE_DEFAULT_TTL_SECONDS=60
CACHE_REFERENCE_TTL_SECONDS=300
CACHE_TAG_TTL_SECONDS=86400

# Database
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=ecommerce
POSTGRES_DB=ecommerce_db
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
DATABASE_URL=postgresql://ecommerce:ecommerce@127.0.0.1:5433/ecommerce_db?schema=public
SHADOW_DATABASE_URL=postgresql://ecommerce:ecommerce@127.0.0.1:5433/ecommerce_shadow_db?schema=public

# Auth
JWT_SECRET=replace-with-a-long-random-access-token-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-token-secret
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
OTP_HASH_SECRET=replace-with-a-long-random-otp-hash-secret

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-character-app-password
EMAIL_FROM_NAME=Ecommerce
EMAIL_FROM_ADDRESS=your-email@gmail.com
# API
API_VERSION=1

# Swagger (optional; when set, protects /api/v{API_VERSION}/docs with Basic Auth)
SWAGGER_USERNAME=admin
SWAGGER_PASSWORD=admin

# Payment provider bootstrap defaults
# Runtime payment behavior reads PaymentGateway records and encrypted dashboard secrets first.
# These dummy test values only seed local/test provider records so Stripe, Tap, Moyasar, and Tabby are visible.
PAYMENT_SECRETS_KEY=development-payment-secret-key
STRIPE_ENVIRONMENT=test
STRIPE_SECRET_KEY=sk_test_dummy_dashboard_stripe_secret
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_dummy_dashboard_stripe_webhook
STRIPE_LOGO_URL=/payment-providers/stripe.svg
STRIPE_ICON_URL=/payment-providers/stripe.svg
STRIPE_API_VERSION=2025-02-24.acacia
STRIPE_CHECKOUT_EXPIRY_MINUTES=31
STRIPE_SUCCESS_PATH=/checkout/success
STRIPE_CANCEL_PATH=/checkout/cancel
STRIPE_ENABLED_METHODS=card,stripe_checkout,stripe_intent
STRIPE_SUPPORTED_COUNTRIES=SA,EG
STRIPE_SUPPORTED_CURRENCIES=SAR,EGP
TAP_ENVIRONMENT=test
TAP_SECRET_KEY=sk_test_dummy_dashboard_tap_secret
TAP_PUBLIC_KEY=pk_test_replace_me
TAP_MERCHANT_ID=dummy_tap_merchant
TAP_WEBHOOK_SECRET=tap_whsec_dummy_dashboard_webhook
TAP_HASH_SECRET=tap_hash_dummy_dashboard_secret
TAP_LOGO_URL=/payment-providers/tap.svg
TAP_ICON_URL=/payment-providers/tap.svg
TAP_ENABLED_METHODS=card,apple_pay,tap_checkout
TAP_SUPPORTED_METHODS=card,apple_pay,mada,stc_pay
TAP_SUPPORTED_COUNTRIES=SA,EG,AE,KW,BH,OM,QA
TAP_SUPPORTED_CURRENCIES=SAR,EGP,AED,KWD,BHD,OMR,QAR
TAP_INSTALLMENT_PLANS=
MOYASAR_ENVIRONMENT=test
MOYASAR_SECRET_KEY=sk_test_dummy_dashboard_moyasar_secret
MOYASAR_PUBLISHABLE_KEY=pk_test_replace_me
MOYASAR_WEBHOOK_SECRET=moyasar_whsec_dummy_dashboard_webhook
MOYASAR_LOGO_URL=/payment-providers/moyasar.svg
MOYASAR_ICON_URL=/payment-providers/moyasar.svg
MOYASAR_ENABLED_METHODS=card,apple_pay,moyasar
MOYASAR_SUPPORTED_METHODS=card,apple_pay,mada
MOYASAR_SUPPORTED_COUNTRIES=SA
MOYASAR_SUPPORTED_CURRENCIES=SAR
TABBY_ENVIRONMENT=test
TABBY_SECRET_KEY=sk_test_dummy_dashboard_tabby_secret
TABBY_PUBLIC_KEY=pk_test_replace_me
TABBY_MERCHANT_CODE=dummy_tabby_merchant
TABBY_WEBHOOK_SECRET=tabby_whsec_dummy_dashboard_webhook
TABBY_LOGO_URL=/payment-providers/tabby.svg
TABBY_ICON_URL=/payment-providers/tabby.svg
TABBY_ENABLED_METHODS=tabby
TABBY_SUPPORTED_COUNTRIES=SA,AE,KW,BH
TABBY_SUPPORTED_CURRENCIES=SAR,AED,KWD,BHD
TABBY_INSTALLMENT_PLANS=2,3,6
