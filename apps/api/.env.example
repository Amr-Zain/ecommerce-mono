# App
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Database
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=ecommerce
POSTGRES_DB=ecommerce_db
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
DATABASE_URL=postgresql://ecommerce:ecommerce@127.0.0.1:5433/ecommerce_db?schema=public
SHADOW_DATABASE_URL=postgresql://ecommerce:ecommerce@127.0.0.1:5433/ecommerce_shadow_db?schema=public

# Auth
JWT_SECRET=replace-with-a-long-random-access-token-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-token-secret
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
OTP_HASH_SECRET=replace-with-a-long-random-otp-hash-secret

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-character-app-password
EMAIL_FROM_NAME=Fayendra
EMAIL_FROM_ADDRESS=your-email@gmail.com
# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=whsec_replace_me

FRONTEND_URL=
