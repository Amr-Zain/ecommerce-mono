model AppSetting {
  id         BigInt   @id @default(autoincrement())
  key        String   @unique
  value      Json     @db.JsonB
  group      String   @default("general")
  groupLabel String?  @map("group_label")
  type       String   @default("string")
  keyLabel   String?  @map("key_label")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([group])
  @@map("settings")
}

model LoyaltyAccount {
  id             BigInt                    @id @default(autoincrement())
  userId         BigInt                    @unique @map("user_id")
  user           User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  availablePoints Int                     @default(0) @map("available_points")
  pendingPoints   Int                     @default(0) @map("pending_points")
  lifetimePoints  Int                     @default(0) @map("lifetime_points")
  currentTierId   BigInt?                 @map("current_tier_id")
  currentTier     LoyaltyTier?            @relation("CurrentLoyaltyTier", fields: [currentTierId], references: [id], onDelete: SetNull)
  status          String                  @default("active")
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @default(now()) @updatedAt @map("updated_at")
  transactions    LoyaltyPointTransaction[]
  redemptions     LoyaltyRewardRedemption[]

  @@index([currentTierId])
  @@index([status])
  @@map("loyalty_accounts")
}

model LoyaltyTier {
  id                BigInt                   @id @default(autoincrement())
  multiplier        Decimal                  @default(1) @db.Decimal(5, 2)
  minLifetimePoints Int                      @default(0) @map("min_lifetime_points")
  color             String?
  isActive          Boolean                  @default(true) @map("is_active")
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @default(now()) @updatedAt @map("updated_at")
  translations      LoyaltyTierTranslation[]
  accounts          LoyaltyAccount[]         @relation("CurrentLoyaltyTier")

  @@index([isActive, minLifetimePoints])
  @@map("loyalty_tiers")
}

model LoyaltyTierTranslation {
  id       BigInt      @id @default(autoincrement())
  recordId BigInt      @map("record_id")
  tier     LoyaltyTier @relation(fields: [recordId], references: [id], onDelete: Cascade)
  langId   String      @map("lang_id")
  name     String

  @@unique([recordId, langId])
  @@map("loyalty_tier_translations")
}

model LoyaltyEarningRule {
  id             BigInt                          @id @default(autoincrement())
  eventKey       String                          @unique @map("event_key")
  pointsType     String                          @map("points_type")
  pointsValue    Decimal                         @map("points_value") @db.Decimal(12, 2)
  minOrderAmount Decimal?                        @map("min_order_amount") @db.Decimal(12, 2)
  startsAt       DateTime?                       @map("starts_at")
  endsAt         DateTime?                       @map("ends_at")
  isActive       Boolean                         @default(true) @map("is_active")
  createdAt      DateTime                        @default(now()) @map("created_at")
  updatedAt      DateTime                        @default(now()) @updatedAt @map("updated_at")
  translations   LoyaltyEarningRuleTranslation[]
  transactions   LoyaltyPointTransaction[]

  @@index([isActive, eventKey])
  @@map("loyalty_earning_rules")
}

model LoyaltyEarningRuleTranslation {
  id          BigInt             @id @default(autoincrement())
  recordId    BigInt             @map("record_id")
  earningRule LoyaltyEarningRule @relation(fields: [recordId], references: [id], onDelete: Cascade)
  langId      String             @map("lang_id")
  name        String
  description String?            @db.Text

  @@unique([recordId, langId])
  @@map("loyalty_earning_rule_translations")
}

model LoyaltyReward {
  id                BigInt                       @id @default(autoincrement())
  pointsRequired    Int                          @map("points_required")
  rewardType        String                       @map("reward_type")
  rewardValue       Decimal                      @map("reward_value") @db.Decimal(12, 2)
  maxDiscountAmount Decimal?                     @map("max_discount_amount") @db.Decimal(12, 2)
  minOrderAmount    Decimal?                     @map("min_order_amount") @db.Decimal(12, 2)
  usageLimit        Int?                         @map("usage_limit")
  usageCount        Int                          @default(0) @map("usage_count")
  perUserLimit      Int                          @default(1) @map("per_user_limit")
  startsAt          DateTime?                    @map("starts_at")
  endsAt            DateTime?                    @map("ends_at")
  isActive          Boolean                      @default(true) @map("is_active")
  createdAt         DateTime                     @default(now()) @map("created_at")
  updatedAt         DateTime                     @default(now()) @updatedAt @map("updated_at")
  translations      LoyaltyRewardTranslation[]
  redemptions       LoyaltyRewardRedemption[]
  transactions      LoyaltyPointTransaction[]

  @@index([isActive, rewardType])
  @@map("loyalty_rewards")
}

model LoyaltyRewardTranslation {
  id          BigInt        @id @default(autoincrement())
  recordId    BigInt        @map("record_id")
  reward      LoyaltyReward @relation(fields: [recordId], references: [id], onDelete: Cascade)
  langId      String        @map("lang_id")
  name        String
  description String?       @db.Text

  @@unique([recordId, langId])
  @@map("loyalty_reward_translations")
}

model LoyaltyPointTransaction {
  id                   BigInt                    @id @default(autoincrement())
  accountId            BigInt                    @map("account_id")
  account              LoyaltyAccount            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  userId               BigInt                    @map("user_id")
  user                 User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  earningRuleId        BigInt?                   @map("earning_rule_id")
  earningRule          LoyaltyEarningRule?       @relation(fields: [earningRuleId], references: [id], onDelete: SetNull)
  rewardId             BigInt?                   @map("reward_id")
  reward               LoyaltyReward?            @relation(fields: [rewardId], references: [id], onDelete: SetNull)
  redemptionId         BigInt?                   @map("redemption_id")
  redemption           LoyaltyRewardRedemption?  @relation(fields: [redemptionId], references: [id], onDelete: SetNull)
  type                 String
  direction            String
  points               Int
  availableDelta       Int                       @default(0) @map("available_delta")
  pendingDelta         Int                       @default(0) @map("pending_delta")
  lifetimeDelta        Int                       @default(0) @map("lifetime_delta")
  status               String                    @default("completed")
  referenceType        String?                   @map("reference_type")
  referenceId          String?                   @map("reference_id")
  idempotencyKey       String?                   @unique @map("idempotency_key")
  description          String?                   @db.Text
  expiresAt            DateTime?                 @map("expires_at")
  completedAt          DateTime?                 @map("completed_at")
  metadata             Json?                     @db.JsonB
  createdAt            DateTime                  @default(now()) @map("created_at")
  updatedAt            DateTime                  @default(now()) @updatedAt @map("updated_at")

  @@index([accountId, status, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([referenceType, referenceId])
  @@map("loyalty_point_transactions")
}

model LoyaltyRewardRedemption {
  id                BigInt                    @id @default(autoincrement())
  accountId         BigInt                    @map("account_id")
  account           LoyaltyAccount            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  userId            BigInt                    @map("user_id")
  user              User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  rewardId          BigInt                    @map("reward_id")
  reward            LoyaltyReward             @relation(fields: [rewardId], references: [id], onDelete: Restrict)
  pendingCheckoutId BigInt?                   @unique @map("pending_checkout_id")
  pendingCheckout   PendingCheckout?          @relation(fields: [pendingCheckoutId], references: [id], onDelete: SetNull)
  orderId           BigInt?                   @map("order_id")
  order             Order?                    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  points            Int
  discountAmount    Decimal                   @map("discount_amount") @db.Decimal(12, 2)
  currency          String                    @default("SAR")
  status            String                    @default("held")
  rewardSnapshot    Json                      @map("reward_snapshot") @db.JsonB
  transaction       LoyaltyPointTransaction[]
  releasedAt        DateTime?                 @map("released_at")
  redeemedAt        DateTime?                 @map("redeemed_at")
  refundedAt        DateTime?                 @map("refunded_at")
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @default(now()) @updatedAt @map("updated_at")

  @@index([userId, status])
  @@index([rewardId])
  @@index([orderId])
  @@map("loyalty_reward_redemptions")
}
