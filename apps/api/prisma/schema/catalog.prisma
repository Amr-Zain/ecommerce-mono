model Collection {
  id       BigInt       @id @default(autoincrement())
  parentId BigInt?      @map("parent_id")
  parent   Collection?  @relation("CollectionParent", fields: [parentId], references: [id], onDelete: SetNull)
  children Collection[] @relation("CollectionParent")

  sortOrder    Int                     @default(0) @map("sort_order")
  isActive     Boolean                 @default(true) @map("is_active")
  createdAt    DateTime                @default(now()) @map("created_at")
  updatedAt    DateTime                @default(now()) @updatedAt @map("updated_at")
  translations CollectionTranslation[]
  products     Product[]

  @@index([parentId])
  @@index([sortOrder])
  @@map("collections")
}

model CollectionTranslation {
  id         BigInt     @id @default(autoincrement())
  recordId   BigInt     @map("record_id")
  collection Collection @relation(fields: [recordId], references: [id], onDelete: Cascade)
  langId     String     @map("lang_id")
  name       String

  @@unique([recordId, langId])
  @@map("collections_translations")
}

model Product {
  id            BigInt      @id @default(autoincrement())
  collectionId  BigInt?     @map("collection_id")
  collection    Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  hasVariants   Boolean     @default(false) @map("has_variants")
  tags          Json?       @map("tags")
  discountType  String?     @map("discount_type")
  discountValue Decimal?    @map("discount_value") @db.Decimal(12, 2)

  isActive         Boolean              @default(true) @map("is_active")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @default(now()) @updatedAt @map("updated_at")
  translations     ProductTranslation[]
  variants         ProductVariant[]
  variantAttribute VariantAttribute[]
  reviews          Review[]
  orderItems       OrderItem[]
  cartItems        CartItem[]
  wishlistItems    WishlistItem[]

  @@index([collectionId])
  @@map("products")
}

model ProductTranslation {
  id          BigInt  @id @default(autoincrement())
  recordId    BigInt  @map("record_id")
  product     Product @relation(fields: [recordId], references: [id], onDelete: Cascade)
  langId      String  @map("lang_id")
  name        String
  description String? @db.Text

  @@unique([recordId, langId])
  @@map("products_translations")
}

model Attribute {
  id           BigInt                 @id @default(autoincrement())
  createdAt    DateTime               @default(now()) @map("created_at")
  translations AttributeTranslation[]
  values       AttributeValue[]
  variants     VariantAttribute[]

  @@map("attributes")
}

model AttributeTranslation {
  id        BigInt    @id @default(autoincrement())
  recordId  BigInt    @map("record_id")
  attribute Attribute @relation(fields: [recordId], references: [id], onDelete: Cascade)
  langId    String    @map("lang_id")
  name      String

  @@unique([recordId, langId])
  @@map("attributes_translations")
}

model AttributeValue {
  id           BigInt                      @id @default(autoincrement())
  attributeId  BigInt                      @map("attribute_id")
  attribute    Attribute                   @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  createdAt    DateTime                    @default(now()) @map("created_at")
  isActive     Boolean                     @default(true) @map("is_active")
  translations AttributeValueTranslation[]
  variants     VariantAttribute[]

  @@index([attributeId])
  @@map("attribute_values")
}

model AttributeValueTranslation {
  id       BigInt         @id @default(autoincrement())
  recordId BigInt         @map("record_id")
  value    AttributeValue @relation(fields: [recordId], references: [id], onDelete: Cascade)
  langId   String         @map("lang_id")
  name     String

  @@unique([recordId, langId])
  @@map("attribute_values_translations")
}

model ProductVariant {
  id        BigInt  @id @default(autoincrement())
  productId BigInt  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  price          Decimal  @db.Decimal(12, 2)
  compareAtPrice Decimal? @map("compare_at_price") @db.Decimal(12, 2)
  costPrice      Decimal? @map("cost_price") @db.Decimal(12, 2)
  discountType   String?  @map("discount_type") // FIXED or PERCENTAGE
  discountValue  Decimal? @map("discount_value") @db.Decimal(12, 2)

  stockQuantity Int      @default(0) @map("stock_quantity")
  barcode       String?  @unique @map("barcode")
  sku           String?  @unique @map("sku")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  attributes        VariantAttribute[]
  orderItems        OrderItem[]
  cartItems         CartItem[]
  inventoryLogs     InventoryLog[]
  priceHistory      PriceHistory[]
  stockReservations StockReservation[]

  @@index([productId])
  @@map("product_variants")
}

model VariantAttribute {
  productId        BigInt         @map("product_id")
  product          Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  productVariantId BigInt         @map("product_variant_id")
  variant          ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  attributeId      BigInt         @map("attribute_id")
  attribute        Attribute      @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  valueId          BigInt         @map("value_id")
  value            AttributeValue @relation(fields: [valueId], references: [id], onDelete: Cascade)

  @@id([productVariantId, attributeId])
  @@unique([productId, productVariantId, attributeId, valueId])
  @@index([productVariantId])
  @@map("variant_attributes")
}

model InventoryLog {
  id            BigInt         @id @default(autoincrement())
  variantId     BigInt         @map("variant_id")
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  changeAmount  Int            @map("change_amount")
  previousStock Int            @map("previous_stock")
  newStock      Int            @map("new_stock")
  reason        String         @map("reason") // RESTOCK, SALE, ADJUSTMENT, RETURN
  createdAt     DateTime       @default(now()) @map("created_at")

  @@index([variantId])
  @@map("inventory_logs")
}

model PriceHistory {
  id                BigInt         @id @default(autoincrement())
  variantId         BigInt         @map("variant_id")
  variant           ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  oldPrice          Decimal        @map("old_price") @db.Decimal(12, 2)
  newPrice          Decimal        @map("new_price") @db.Decimal(12, 2)
  oldCompareAtPrice Decimal?       @map("old_compare_at_price") @db.Decimal(12, 2)
  newCompareAtPrice Decimal?       @map("new_compare_at_price") @db.Decimal(12, 2)
  createdAt         DateTime       @default(now()) @map("created_at")

  @@index([variantId])
  @@map("price_history")
}
