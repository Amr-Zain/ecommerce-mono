model Role {
  id           BigInt            @id @default(autoincrement())
  isActive     Boolean           @default(true) @map("is_active")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @default(now()) @updatedAt @map("updated_at")
  users        User[]
  permissions  Permission[]      @relation("RoleToPermission")
  translations RoleTranslation[]

  @@map("roles")
}

model RoleTranslation {
  id       BigInt @id @default(autoincrement())
  recordId BigInt @map("record_id")
  role     Role   @relation(fields: [recordId], references: [id], onDelete: Cascade)
  langId   String @map("lang_id")
  name     String

  @@unique([recordId, langId])
  @@map("roles_translations")
}

model Permission {
  id        BigInt   @id @default(autoincrement())
  resource  String // e.g., "users", "orders", "products"
  action    String // e.g., "create", "read", "update", "delete", "list"
  roles     Role[]   @relation("RoleToPermission")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([resource, action])
  @@map("permissions")
}

model User {
  id                      BigInt                    @id @default(autoincrement())
  name                    String?
  email                   String?                   @unique
  roleId                  BigInt?                   @map("role")
  role                    Role?                     @relation(fields: [roleId], references: [id], onDelete: SetNull)
  userType                String?                   @default("client") @map("user_type")
  password                String?
  gender                  String?
  phone                   String?
  phoneCode               String?                   @map("phone_code")
  isPhoneVerified         Boolean                   @default(false) @map("is_phone_verified")
  isEmailVerified         Boolean                   @default(false) @map("is_email_verified")
  isActive                Boolean                   @default(true) @map("is_active")
  phoneVerificationCode   String?                   @map("phone_verification_code") // 4-digit code
  phoneVerificationExpiry DateTime?                 @map("phone_verification_expiry")
  settings                Json?                     @default("{}")
  createdAt               DateTime                  @default(now()) @map("created_at")
  updatedAt               DateTime                  @default(now()) @updatedAt @map("updated_at")
  addresses               Address[]
  reviews                 Review[]
  orders                  Order[]
  returnRequests          ReturnRequest[]
  exchangeRequests        ExchangeRequest[]
  refreshTokens           RefreshToken[]
  cart                    Cart?
  wishlistItems           WishlistItem[]
  wallets                 Wallet[]
  walletTransactions      WalletTransaction[]
  walletWithdrawals       WalletWithdrawalRequest[]
  notifications           Notification[]
  emailOtpChallenges      EmailOtpChallenge[]
  tickets                 Ticket[]
  ticketMessages          TicketMessage[]
  messageCampaigns        MessageCampaign[]         @relation("MessageCampaignSender")
  messageRecipients       MessageCampaignRecipient[]

  @@index([phone])
  @@index([phoneCode, phone])
  @@index([userType])
  @@index([roleId])
  @@map("users")
}

model EmailOtpChallenge {
  id            String    @id @default(uuid())
  userId        BigInt?   @map("user_id")
  user          User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipient     String
  purpose       String
  codeHash      String    @map("code_hash")
  expiresAt     DateTime  @map("expires_at")
  attempts      Int       @default(0)
  maxAttempts   Int       @default(5) @map("max_attempts")
  requestIp     String?   @map("request_ip")
  locale        String    @default("en")
  activeKey     String?   @unique @map("active_key")
  consumedAt    DateTime? @map("consumed_at")
  invalidatedAt DateTime? @map("invalidated_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([recipient, purpose, createdAt])
  @@index([requestIp, createdAt])
  @@index([expiresAt])
  @@map("email_otp_challenges")
}

model AnonymousSession {
  id            String         @id @default(uuid())
  tokenHash     String         @unique @map("token_hash")
  expiresAt     DateTime       @map("expires_at")
  lastActiveAt  DateTime       @default(now()) @map("last_active_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  cart          Cart?
  wishlistItems WishlistItem[]

  @@index([expiresAt])
  @@map("anonymous_sessions")
}

model RefreshToken {
  id         BigInt   @id @default(autoincrement())
  userId     BigInt   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String   @unique
  deviceInfo String?  @map("device_info") // Browser, OS, etc.
  ipAddress  String?  @map("ip_address")
  expiresAt  DateTime @map("expires_at")
  isRevoked  Boolean  @default(false) @map("is_revoked")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId, isRevoked, createdAt(sort: Desc)])
  @@map("refresh_tokens")
}
