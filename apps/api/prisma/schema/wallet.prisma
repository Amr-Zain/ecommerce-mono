model Wallet {
  id               BigInt                    @id @default(autoincrement())
  userId           BigInt                    @map("user_id")
  user             User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  currency         String                    @default("SAR")
  availableBalance Decimal                   @default(0) @map("available_balance") @db.Decimal(12, 2)
  pendingBalance   Decimal                   @default(0) @map("pending_balance") @db.Decimal(12, 2)
  status           String                    @default("active")
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime                  @default(now()) @updatedAt @map("updated_at")
  transactions     WalletTransaction[]
  withdrawals      WalletWithdrawalRequest[]

  @@unique([userId, currency])
  @@index([status])
  @@map("wallets")
}

model WalletTransaction {
  id              BigInt                   @id @default(autoincrement())
  walletId        BigInt                   @map("wallet_id")
  wallet          Wallet                   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  userId          BigInt                   @map("user_id")
  user            User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            String
  direction       String
  amount          Decimal                  @db.Decimal(12, 2)
  currency        String                   @default("SAR")
  status          String                   @default("pending")
  paymentMethod   String?                  @map("payment_method")
  transactionRef  String?                  @unique @map("transaction_ref")
  referenceType   String?                  @map("reference_type")
  referenceId     String?                  @map("reference_id")
  description     String?                  @db.Text
  gatewayResponse Json?                    @map("gateway_response") @db.JsonB
  metadata        Json?                    @db.JsonB
  completedAt     DateTime?                @map("completed_at")
  failedAt        DateTime?                @map("failed_at")
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @default(now()) @updatedAt @map("updated_at")
  withdrawal      WalletWithdrawalRequest?

  @@index([walletId, status, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([referenceType, referenceId])
  @@map("wallet_transactions")
}

model WalletWithdrawalRequest {
  id                BigInt            @id @default(autoincrement())
  walletId          BigInt            @map("wallet_id")
  wallet            Wallet            @relation(fields: [walletId], references: [id], onDelete: Cascade)
  userId            BigInt            @map("user_id")
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactionId     BigInt            @unique @map("transaction_id")
  transaction       WalletTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  amount            Decimal           @db.Decimal(12, 2)
  currency          String            @default("SAR")
  method            String
  details           Json              @db.JsonB
  status            String            @default("requested")
  transferReference String?           @map("transfer_reference")
  clientNote        String?           @map("client_note") @db.Text
  adminNote         String?           @map("admin_note") @db.Text
  requestedAt       DateTime          @default(now()) @map("requested_at")
  approvedAt        DateTime?         @map("approved_at")
  paidAt            DateTime?         @map("paid_at")
  rejectedAt        DateTime?         @map("rejected_at")
  failedAt          DateTime?         @map("failed_at")
  cancelledAt       DateTime?         @map("cancelled_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @default(now()) @updatedAt @map("updated_at")

  @@index([walletId])
  @@index([userId])
  @@index([status])
  @@index([method])
  @@index([createdAt])
  @@map("wallet_withdrawal_requests")
}
