model OutboxEvent {
  id            BigInt    @id @default(autoincrement())
  eventId       String    @unique @map("event_id")
  eventName     String    @map("event_name")
  version       Int       @default(1)
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  actor         Json?     @db.JsonB
  payload       Json      @db.JsonB
  occurredAt    DateTime  @map("occurred_at")
  status        String    @default("pending")
  attempts      Int       @default(0)
  availableAt   DateTime  @default(now()) @map("available_at")
  lockedAt      DateTime? @map("locked_at")
  processedAt   DateTime? @map("processed_at")
  lastError     String?   @map("last_error") @db.Text
  createdAt     DateTime  @default(now()) @map("created_at")

  receipts EventConsumerReceipt[]

  @@index([status, availableAt])
  @@map("outbox_events")
}

model EventConsumerReceipt {
  id           BigInt      @id @default(autoincrement())
  eventId      String      @map("event_id")
  consumerName String      @map("consumer_name")
  processedAt  DateTime    @default(now()) @map("processed_at")
  event        OutboxEvent @relation(fields: [eventId], references: [eventId], onDelete: Cascade)

  @@unique([eventId, consumerName])
  @@map("event_consumer_receipts")
}

model Notification {
  id               BigInt    @id @default(autoincrement())
  recipientId      BigInt    @map("recipient_id")
  recipient        User      @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  eventId          String    @map("event_id")
  notificationType String    @map("notification_type")
  titleKey         String    @map("title_key")
  bodyKey          String    @map("body_key")
  args             Json?     @db.JsonB
  data             Json?     @db.JsonB
  readAt           DateTime? @map("read_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@unique([eventId, recipientId, notificationType])
  @@index([recipientId, readAt, createdAt])
  @@map("notifications")
}

model MessageTemplate {
  id        BigInt   @id @default(autoincrement())
  key       String   @unique
  name      String
  channel   String
  purpose   String
  content   Json     @db.JsonB
  variables Json?    @db.JsonB
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  campaigns MessageCampaign[]

  @@index([channel, purpose, isActive])
  @@map("message_templates")
}

model MessageCampaign {
  id                BigInt          @id @default(autoincrement())
  templateId        BigInt          @map("template_id")
  template          MessageTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  senderId          BigInt?         @map("sender_id")
  sender            User?           @relation("MessageCampaignSender", fields: [senderId], references: [id], onDelete: SetNull)
  channel           String
  locale            String          @default("profile")
  recipientType     String          @map("recipient_type")
  recipientUserType String?         @map("recipient_user_type")
  titleOverride     String?         @map("title_override")
  variables         Json?           @db.JsonB
  templateSnapshot  Json            @map("template_snapshot") @db.JsonB
  status            String          @default("queued")
  queuedCount       Int             @default(0) @map("queued_count")
  sentCount         Int             @default(0) @map("sent_count")
  failedCount       Int             @default(0) @map("failed_count")
  skippedCount      Int             @default(0) @map("skipped_count")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @default(now()) @updatedAt @map("updated_at")

  recipients MessageCampaignRecipient[]

  @@index([status, createdAt])
  @@index([templateId])
  @@map("message_campaigns")
}

model MessageCampaignRecipient {
  id         BigInt          @id @default(autoincrement())
  campaignId BigInt          @map("campaign_id")
  campaign   MessageCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId     BigInt          @map("user_id")
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel    String
  email      String?
  status     String          @default("queued")
  error      String?         @db.Text
  sentAt     DateTime?       @map("sent_at")
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @default(now()) @updatedAt @map("updated_at")

  @@unique([campaignId, userId, channel])
  @@index([campaignId, status])
  @@index([userId])
  @@map("message_campaign_recipients")
}
