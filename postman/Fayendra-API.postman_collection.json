{
	"info": {
		"_postman_id": "fayendra-api-collection",
		"name": "Fayendra API",
		"description": "Complete API collection for Fayendra E-commerce platform",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Users",
			"item": [
				{
					"name": "Create User",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john.doe@example.com\",\n  \"password\": \"password123\",\n  \"phone\": \"1234567890\",\n  \"phoneCode\": \"+1\",\n  \"userType\": \"client\",\n  \"isActive\": true\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/users",
							"host": ["{{baseUrl}}"],
							"path": ["users"]
						},
						"description": "Create a new user"
					},
					"response": []
				},
				{
					"name": "Get All Users (Paginated)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/users?page=1&limit=10",
							"host": ["{{baseUrl}}"],
							"path": ["users"],
							"query": [
								{
									"key": "page",
									"value": "1",
									"description": "Page number"
								},
								{
									"key": "limit",
									"value": "10",
									"description": "Items per page (max 100)"
								}
							]
						},
						"description": "Get all users with pagination"
					},
					"response": []
				},
				{
					"name": "Get All Users (No Pagination)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/users?paginate=0",
							"host": ["{{baseUrl}}"],
							"path": ["users"],
							"query": [
								{
									"key": "paginate",
									"value": "0",
									"description": "Disable pagination to get all results"
								}
							]
						},
						"description": "Get all users without pagination"
					},
					"response": []
				},
				{
					"name": "Get Active Users",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/users?filters[isActive]=1&page=1&limit=10",
							"host": ["{{baseUrl}}"],
							"path": ["users"],
							"query": [
								{
									"key": "filters[isActive]",
									"value": "1",
									"description": "Filter by active status"
								},
								{
									"key": "page",
									"value": "1"
								},
								{
									"key": "limit",
									"value": "10"
								}
							]
						},
						"description": "Get only active users"
					},
					"response": []
				},
				{
					"name": "Search Users",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/users?search=john&page=1&limit=10",
							"host": ["{{baseUrl}}"],
							"path": ["users"],
							"query": [
								{
									"key": "search",
									"value": "john",
									"description": "Search in name and email fields"
								},
								{
									"key": "page",
									"value": "1"
								},
								{
									"key": "limit",
									"value": "10"
								}
							]
						},
						"description": "Search users by name or email"
					},
					"response": []
				},
				{
					"name": "Filter and Sort Users",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/users?filters[isActive]=1&filters[isEmailVerified]=1&sort[createdAt]=desc&sort[name]=asc&page=1&limit=10",
							"host": ["{{baseUrl}}"],
							"path": ["users"],
							"query": [
								{
									"key": "filters[isActive]",
									"value": "1",
									"description": "Filter by active status"
								},
								{
									"key": "filters[isEmailVerified]",
									"value": "1",
									"description": "Filter by email verified status"
								},
								{
									"key": "sort[createdAt]",
									"value": "desc",
									"description": "Sort by creation date descending"
								},
								{
									"key": "sort[name]",
									"value": "asc",
									"description": "Then sort by name ascending"
								},
								{
									"key": "page",
									"value": "1"
								},
								{
									"key": "limit",
									"value": "10"
								}
							]
						},
						"description": "Filter active and verified users, sorted by creation date and name"
					},
					"response": []
				},
				{
					"name": "Get User by ID",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/users/1",
							"host": ["{{baseUrl}}"],
							"path": ["users", "1"]
						},
						"description": "Get a single user by ID"
					},
					"response": []
				},
				{
					"name": "Update User",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"John Updated\",\n  \"email\": \"john.updated@example.com\",\n  \"isActive\": true\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/users/1",
							"host": ["{{baseUrl}}"],
							"path": ["users", "1"]
						},
						"description": "Update user information"
					},
					"response": []
				},
				{
					"name": "Delete User",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/users/1",
							"host": ["{{baseUrl}}"],
							"path": ["users", "1"]
						},
						"description": "Delete a user by ID"
					},
					"response": []
				},
				{
					"name": "Get Users Count",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/users/count/total",
							"host": ["{{baseUrl}}"],
							"path": ["users", "count", "total"]
						},
						"description": "Get total count of users"
					},
					"response": []
				}
			],
			"description": "User management endpoints"
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:3000",
			"type": "string"
		}
	]
}
