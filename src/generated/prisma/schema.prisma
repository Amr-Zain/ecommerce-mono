model Role {
  id        BigInt   @id @default(autoincrement())
  nameAr    String   @map("name_ar")
  nameEn    String   @map("name_en")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  users     User[]

  @@map("roles")
}

model User {
  id              BigInt    @id @default(autoincrement())
  name            String
  email           String?   @unique
  imageId         BigInt?   @map("image_id")
  image           Media?    @relation("UserImage", fields: [imageId], references: [id], onDelete: SetNull)
  roleId          BigInt?   @map("role")
  role            Role?     @relation(fields: [roleId], references: [id], onDelete: SetNull)
  userType        String    @default("client") @map("user_type")
  guestToken      String?   @unique @map("guest_token")
  password        String?
  phone           String?
  phoneCode       String?   @map("phone_code")
  isPhoneVerified Boolean   @default(false) @map("is_phone_verified")
  isEmailVerified Boolean   @default(false) @map("is_email_verified")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")
  addresses       Address[]
  reviews         Review[]
  orders          Order[]

  @@index([email])
  @@index([phone])
  @@index([roleId])
  @@index([guestToken])
  @@map("users")
}

generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id       BigInt     @id @default(autoincrement())
  parentId BigInt?    @map("parent_id")
  parent   Category?  @relation("CategoryParent", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryParent")
  imageId  BigInt?    @map("image_id")
  image    Media?     @relation("CategoryImage", fields: [imageId], references: [id], onDelete: SetNull)

  sortOrder    Int                   @default(0) @map("sort_order")
  isActive     Boolean               @default(true) @map("is_active")
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @default(now()) @updatedAt @map("updated_at")
  translations CategoryTranslation[]
  products     Product[]

  @@index([parentId])
  @@index([sortOrder])
  @@map("categories")
}

model CategoryTranslation {
  id         BigInt   @id @default(autoincrement())
  categoryId BigInt   @map("category_id")
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  langId     String   @map("lang_id")
  name       String

  @@unique([categoryId, langId])
  @@map("categories_translations")
}

model Product {
  id          BigInt    @id @default(autoincrement())
  categoryId  BigInt?   @map("category_id")
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  hasVariants Boolean   @default(false) @map("has_variants")
  imageId     BigInt?   @map("image_id")
  image       Media?    @relation("ProductImage", fields: [imageId], references: [id], onDelete: SetNull)

  price            Decimal              @default(0) @map("price") @db.Decimal(12, 2)
  discountValue    Decimal              @default(0) @map("discount_value") @db.Decimal(12, 2)
  discountType     String?              @map("discount_type")
  stockQuantity    Int                  @default(0) @map("stock_quantity")
  barcode          String?              @map("barcode")
  sku              String?              @map("sku")
  isActive         Boolean              @default(true) @map("is_active")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @default(now()) @updatedAt @map("updated_at")
  translations     ProductTranslation[]
  variants         ProductVariant[]
  variantAttribute VariantAttribute[]
  reviews          Review[]
  prices           ProductPrice[]
  orderItems       OrderItem[]

  @@index([categoryId])
  @@index([sku])
  @@index([barcode])
  @@map("products")
}

model ProductTranslation {
  id          BigInt  @id @default(autoincrement())
  productId   BigInt  @map("product_id")
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  langId      String  @map("lang_id") // Removed Lang enum
  name        String
  description String? @db.Text

  @@unique([productId, langId])
  @@map("products_translations")
}

model Attribute {
  id           BigInt                 @id @default(autoincrement())
  createdAt    DateTime               @default(now()) @map("created_at")
  translations AttributeTranslation[]
  values       AttributeValue[]
  variants     VariantAttribute[]

  @@map("attributes")
}

model AttributeTranslation {
  id          BigInt    @id @default(autoincrement())
  attributeId BigInt    @map("attribute_id")
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  langId      String    @map("lang_id") // Removed Lang enum
  name        String

  @@unique([attributeId, langId])
  @@map("attributes_translations")
}

model AttributeValue {
  id           BigInt                      @id @default(autoincrement())
  attributeId  BigInt                      @map("attribute_id")
  attribute    Attribute                   @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  createdAt    DateTime                    @default(now()) @map("created_at")
  translations AttributeValueTranslation[]
  variants     VariantAttribute[]

  @@index([attributeId])
  @@map("attribute_values")
}

model AttributeValueTranslation {
  id      BigInt         @id @default(autoincrement())
  valueId BigInt         @map("value_id")
  value   AttributeValue @relation(fields: [valueId], references: [id], onDelete: Cascade)
  langId  String         @map("lang_id") // Removed Lang enum
  name    String

  @@unique([valueId, langId])
  @@map("attribute_values_translations")
}

model ProductVariant {
  id            BigInt             @id @default(autoincrement())
  productId     BigInt             @map("product_id")
  product       Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockQuantity Int                @default(0) @map("stock_quantity")
  barcode       String?            @map("barcode")
  sku           String?            @map("sku")
  isActive      Boolean            @default(true) @map("is_active")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @default(now()) @updatedAt @map("updated_at")
  attributes    VariantAttribute[]
  orderItems    OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

model VariantAttribute {
  productId        BigInt         @map("product_id")
  product          Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  productVariantId BigInt         @map("product_variant_id")
  variant          ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  attributeId      BigInt         @map("attribute_id")
  attribute        Attribute      @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  valueId          BigInt         @map("value_id")
  value            AttributeValue @relation(fields: [valueId], references: [id], onDelete: Cascade)

  @@id([productVariantId, attributeId])
  @@unique([productId, productVariantId, attributeId, valueId])
  @@index([productVariantId])
  @@map("variant_attributes")
}

model ProductPrice {
  id            BigInt   @id @default(autoincrement())
  productId     BigInt   @map("product_id")
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  price         Decimal  @map("price") @db.Decimal(12, 2)
  discountValue Decimal  @default(0) @map("discount_value") @db.Decimal(12, 2)
  discountType  String?  @map("discount_type")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([productId])
  @@index([productId, isActive])
  @@map("product_prices")
}

model StaticPage {
  id           BigInt                  @id @default(autoincrement())
  slug         String                  @unique
  isActive     Boolean                 @default(true) @map("is_active")
  createdAt    DateTime                @default(now()) @map("created_at")
  updatedAt    DateTime                @default(now()) @updatedAt @map("updated_at")
  translations StaticPageTranslation[]
  sections     PageSection[]

  @@map("static_pages")
}

model StaticPageTranslation {
  id           BigInt     @id @default(autoincrement())
  staticPageId BigInt     @map("static_page_id")
  staticPage   StaticPage @relation(fields: [staticPageId], references: [id], onDelete: Cascade)
  langId       String     @map("lang_id") // Removed Lang enum
  title        String
  content      String?    @db.Text

  @@unique([staticPageId, langId])
  @@map("static_pages_translations")
}

model PageSection {
  id           BigInt                   @id @default(autoincrement())
  staticPageId BigInt                   @map("static_page_id")
  staticPage   StaticPage               @relation(fields: [staticPageId], references: [id], onDelete: Cascade)
  sortOrder    Int                      @default(0) @map("sort_order")
  isActive     Boolean                  @default(true) @map("is_active")
  createdAt    DateTime                 @default(now()) @map("created_at")
  updatedAt    DateTime                 @default(now()) @updatedAt @map("updated_at")
  translations PageSectionTranslation[]

  @@index([staticPageId])
  @@index([sortOrder])
  @@map("page_sections")
}

model PageSectionTranslation {
  id            BigInt      @id @default(autoincrement())
  pageSectionId BigInt      @map("page_section_id")
  pageSection   PageSection @relation(fields: [pageSectionId], references: [id], onDelete: Cascade)
  langId        String      @map("lang_id") // Removed Lang enum
  title         String?
  content       String?     @db.Text

  @@unique([pageSectionId, langId])
  @@map("page_sections_translations")
}

model Slider {
  id           BigInt              @id @default(autoincrement())
  imageId      BigInt?             @map("image_id")
  image        Media?              @relation("SliderImage", fields: [imageId], references: [id], onDelete: SetNull)
  sortOrder    Int                 @default(0) @map("sort_order")
  startDate    DateTime?           @map("start_date")
  endDate      DateTime?           @map("end_date")
  isActive     Boolean             @default(true) @map("is_active")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @default(now()) @updatedAt @map("updated_at")
  translations SliderTranslation[]

  @@index([sortOrder])
  @@map("sliders")
}

model SliderTranslation {
  id       BigInt  @id @default(autoincrement())
  sliderId BigInt  @map("slider_id")
  slider   Slider  @relation(fields: [sliderId], references: [id], onDelete: Cascade)
  langId   String  @map("lang_id") // Removed Lang enum
  title    String?

  @@unique([sliderId, langId])
  @@map("sliders_translations")
}

model Faq {
  id           BigInt           @id @default(autoincrement())
  sortOrder    Int              @default(0) @map("sort_order")
  isActive     Boolean          @default(true) @map("is_active")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @default(now()) @updatedAt @map("updated_at")
  translations FaqTranslation[]

  @@index([sortOrder])
  @@map("faqs")
}

model FaqTranslation {
  id       BigInt @id @default(autoincrement())
  faqId    BigInt @map("faq_id")
  faq      Faq    @relation(fields: [faqId], references: [id], onDelete: Cascade)
  langId   String @map("lang_id") // Removed Lang enum
  question String @db.Text
  answer   String @db.Text

  @@unique([faqId, langId])
  @@map("faqs_translations")
}

model Review {
  id         BigInt   @id @default(autoincrement())
  userId     BigInt   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId  BigInt   @map("product_id")
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating     Int
  comment    String?  @db.Text
  isVerified Boolean  @default(false) @map("is_verified")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@map("reviews")
}

model Country {
  id             BigInt               @id @default(autoincrement())
  phoneCode      String               @map("phone_code")
  phoneLength    Int?                 @map("phone_length")
  shippingPrice  Decimal              @default(0) @map("shipping_price") @db.Decimal(12, 2)
  isActive       Boolean              @default(true) @map("is_active")
  phoneStartWith Int                  @map("phone_start_with")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @default(now()) @updatedAt @map("updated_at")
  translations   CountryTranslation[]
  cities         City[]
  addresses      Address[]

  @@map("countries")
}

model CountryTranslation {
  id           BigInt   @id @default(autoincrement())
  countryId    BigInt   @map("country_id")
  country      Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  langId       String   @map("lang_id")
  name         String
  nationality  String?
  shortName    String?  @map("short_name")
  currencyCode String?  @map("currency_code")
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([countryId, langId])
  @@map("countries_translations")
}

model City {
  id           BigInt            @id @default(autoincrement())
  countryId    BigInt            @map("country_id")
  country      Country           @relation(fields: [countryId], references: [id], onDelete: Cascade)
  isActive     Boolean           @default(true) @map("is_active")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @default(now()) @updatedAt @map("updated_at")
  translations CityTranslation[]
  addresses    Address[]

  @@index([countryId])
  @@map("cities")
}

model CityTranslation {
  id     BigInt @id @default(autoincrement())
  cityId BigInt @map("city_id")
  city   City   @relation(fields: [cityId], references: [id], onDelete: Cascade)
  langId String @map("lang_id") // Removed Lang enum
  name   String

  @@unique([cityId, langId])
  @@map("cities_translations")
}

model Address {
  id             BigInt   @id @default(autoincrement())
  userId         BigInt   @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  address        String   @db.Text
  cityId         BigInt?  @map("city_id")
  city           City?    @relation(fields: [cityId], references: [id], onDelete: SetNull)
  countryId      BigInt?  @map("country_id")
  country        Country? @relation(fields: [countryId], references: [id], onDelete: SetNull)
  streetName     String?  @map("street_name")
  buildingNumber String?  @map("building_number")
  isDefault      Boolean  @default(false) @map("is_default")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")
  orders         Order[]

  @@index([userId])
  @@index([cityId])
  @@index([countryId])
  @@map("addresses")
}

model Media {
  id           BigInt   @id @default(autoincrement())
  uuid         String   @unique @default(uuid()) @db.Uuid
  attachHash   String?  @map("attach_hash")
  model        String
  modelId      String?  @map("model_id")
  collection   String?
  path         String   @db.Text
  filename     String
  originalName String   @map("original_name")
  extension    String
  mimeType     String   @map("mime_type")
  type         String
  size         Int
  metadata     Json?    @db.JsonB
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  categories Category[] @relation("CategoryImage")
  products   Product[]  @relation("ProductImage")
  sliders    Slider[]   @relation("SliderImage")
  users      User[]     @relation("UserImage")

  @@index([uuid])
  @@index([model, modelId])
  @@index([model, modelId, collection])
  @@index([model, attachHash])
  @@index([type])
  @@map("media")
}

model Order {
  id            BigInt         @id @default(autoincrement())
  userId        BigInt         @map("user_id")
  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  addressId     BigInt?        @map("address_id")
  address       Address?       @relation(fields: [addressId], references: [id], onDelete: SetNull)
  vatValue      Decimal        @default(0) @map("vat_value") @db.Decimal(12, 2)
  vatType       String?        @map("vat_type")
  status        String         @default("pending")
  paymentMethod String         @map("payment_method")
  paymentStatus String         @default("pending") @map("payment_status")
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at")
  items         OrderItem[]
  payments      OrderPayment[]

  @@index([userId])
  @@index([addressId])
  @@index([status])
  @@index([paymentStatus])
  @@map("orders")
}

model OrderItem {
  id                    BigInt                 @id @default(autoincrement())
  orderId               BigInt                 @map("order_id")
  order                 Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId             BigInt?                @map("product_id")
  product               Product?               @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId             BigInt?                @map("variant_id")
  variant               ProductVariant?        @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity              Int                    @default(1)
  unitPriceSnapshot     Decimal                @default(0) @map("unit_price_snapshot") @db.Decimal(12, 2)
  discountValueSnapshot Decimal                @default(0) @map("discount_value_snapshot") @db.Decimal(12, 2)
  discountTypeSnapshot  String?                @map("discount_type_snapshot")
  isActive              Boolean                @default(true) @map("is_active")
  createdAt             DateTime               @default(now()) @map("created_at")
  translations          OrderItemTranslation[]

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@map("order_items")
}

model OrderItemTranslation {
  id                  BigInt    @id @default(autoincrement())
  orderItemId         BigInt    @map("order_item_id")
  orderItem           OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  langId              String    @map("lang_id") // Removed Lang enum
  nameSnapshot        String    @map("name_snapshot")
  descriptionSnapshot String?   @map("description_snapshot") @db.Text

  @@unique([orderItemId, langId])
  @@map("order_items_translations")
}

model OrderPayment {
  id            BigInt   @id @default(autoincrement())
  orderId       BigInt   @map("order_id")
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  totalPrice    Decimal  @default(0) @map("total_price") @db.Decimal(12, 2)
  vatValue      Decimal  @default(0) @map("vat_value") @db.Decimal(12, 2)
  vatType       String?  @map("vat_type")
  paymentMethod String   @map("payment_method")
  paymentStatus String   @default("pending") @map("payment_status")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([orderId])
  @@index([paymentStatus])
  @@map("order_payments")
}
