model StaticPage {
  id           BigInt                  @id @default(autoincrement())
  slug         String                  @unique
  isActive     Boolean                 @default(true) @map("is_active")
  createdAt    DateTime                @default(now()) @map("created_at")
  updatedAt    DateTime                @default(now()) @updatedAt @map("updated_at")
  model        String                  @default("static_page")
  translations StaticPageTranslation[]
  sections     PageSection[]
  media        Media[]                 @relation("StaticPageMedia")

  @@unique([model, id])
  @@map("static_pages")
}

model StaticPageTranslation {
  id       BigInt     @id @default(autoincrement())
  recordId BigInt     @map("record_id")
  staticPage StaticPage @relation(fields: [recordId], references: [id], onDelete: Cascade)
  langId   String     @map("lang_id") // Removed Lang enum
  title    String
  content  String?    @db.Text

  @@unique([recordId, langId])
  @@map("static_pages_translations")
}

model PageSection {
  id           BigInt                   @id @default(autoincrement())
  staticPageId BigInt                   @map("static_page_id")
  staticPage   StaticPage               @relation(fields: [staticPageId], references: [id], onDelete: Cascade)
  sortOrder    Int                      @default(0) @map("sort_order")
  isActive     Boolean                  @default(true) @map("is_active")
  createdAt    DateTime                 @default(now()) @map("created_at")
  updatedAt    DateTime                 @default(now()) @updatedAt @map("updated_at")
  model        String                   @default("page_section")
  translations PageSectionTranslation[]
  media        Media[]                  @relation("PageSectionMedia")

  @@unique([model, id])
  @@index([staticPageId])
  @@index([sortOrder])
  @@map("page_sections")
}

model PageSectionTranslation {
  id          BigInt      @id @default(autoincrement())
  recordId    BigInt      @map("record_id")
  pageSection PageSection @relation(fields: [recordId], references: [id], onDelete: Cascade)
  langId      String      @map("lang_id") // Removed Lang enum
  title       String?
  content     String?     @db.Text

  @@unique([recordId, langId])
  @@map("page_sections_translations")
}

model Slider {
  id           BigInt              @id @default(autoincrement())
  model        String              @default("slider")
  media        Media[]             @relation("SliderMedia")
  sortOrder    Int                 @default(0) @map("sort_order")
  startDate    DateTime?           @map("start_date")
  endDate      DateTime?           @map("end_date")
  isActive     Boolean             @default(true) @map("is_active")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @default(now()) @updatedAt @map("updated_at")
  translations SliderTranslation[]

  @@unique([model, id])
  @@index([sortOrder])
  @@map("sliders")
}

model SliderTranslation {
  id       BigInt  @id @default(autoincrement())
  recordId BigInt  @map("record_id")
  slider   Slider  @relation(fields: [recordId], references: [id], onDelete: Cascade)
  langId   String  @map("lang_id") // Removed Lang enum
  title    String?

  @@unique([recordId, langId])
  @@map("sliders_translations")
}

model Faq {
  id           BigInt           @id @default(autoincrement())
  sortOrder    Int              @default(0) @map("sort_order")
  isActive     Boolean          @default(true) @map("is_active")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @default(now()) @updatedAt @map("updated_at")
  model        String           @default("faq")
  translations FaqTranslation[]
  media        Media[]          @relation("FaqMedia")

  @@unique([model, id])
  @@index([sortOrder])
  @@map("faqs")
}

model FaqTranslation {
  id       BigInt @id @default(autoincrement())
  recordId BigInt @map("record_id")
  faq      Faq    @relation(fields: [recordId], references: [id], onDelete: Cascade)
  langId   String @map("lang_id") // Removed Lang enum
  question String @db.Text
  answer   String @db.Text

  @@unique([recordId, langId])
  @@map("faqs_translations")
}

model Review {
  id         BigInt   @id @default(autoincrement())
  userId     BigInt   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId  BigInt   @map("product_id")
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating     Int
  comment    String?  @db.Text
  isVerified Boolean  @default(false) @map("is_verified")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  model      String   @default("review")
  media      Media[]  @relation("ReviewMedia")

  @@unique([model, id])
  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@map("reviews")
}
